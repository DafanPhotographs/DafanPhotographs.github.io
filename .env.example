# 复制为 .env 后填写（.env 已加入 .gitignore，不会被提交）
# Cloudinary 控制台 → Settings → Upload → Upload presets → Add upload preset
#   Signing Mode = Unsigned；建议 Folder = dafan/series
CLOUDINARY_CLOUD_NAME=no7rdn4w
CLOUDINARY_UPLOAD_PRESET=你的_unsigned_preset_名称

# 可选：本地 CLI 使用；后台页把 PAT 存在浏览器 localStorage，不读这个文件
# GITHUB_OWNER=DafanPhotographs
# GITHUB_REPO=DafanPhotographs.github.io
# GITHUB_PAT=github_pat_xxxxxxxx
